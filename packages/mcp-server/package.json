{
  "name": "@react-insight/mcp",
  "version": "0.1.0",
  "description": "MCP server for React Insight — live diagnostic tools for coding agents",
  "type": "module",
  "bin": {
    "react-insight-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser-client": {
      "types": "./dist/browser-client.d.ts",
      "import": "./dist/browser-client.js",
      "require": "./dist/browser-client.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "react-insight": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.9"
  }
}
